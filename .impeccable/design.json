  "narrative": {
    "northStar": "A Folha do Missal",
    "overview": "O app é uma folha de missal posta no celular: pergaminho claro, tinta escura, um único vinho para o que é ação, e a data de cada missa em numeral serifado. A interface é de operar: personalidade em poucos detalhes e o resto familiar.",
    "keyCharacteristics": [
      "Um único acento (vinho); dourado só como atenção",
      "Superfícies mais claras que o fundo, com filete de 1 px; sem sombras",
      "Spectral em títulos e numerais; sistema no resto",
      "O bloco de data como único gesto decorativo",
      "Claro e escuro desde o início"
    ],
    "rules": [
      {
        "name": "The One Voice Rule",
        "body": "O vinho é a única cor de ação.",
        "section": "colors"
      },
      {
        "name": "The Never Color Alone Rule",
        "body": "Estado nunca é só cor: sempre ícone e texto.",
        "section": "colors"
      },
      {
        "name": "The Lifted Surface Rule",
        "body": "Camadas se distinguem por ficarem mais claras que o fundo e por um filete.",
        "section": "colors"
      },
      {
        "name": "The Serif Stays Home Rule",
        "body": "Serifa só em título, seção e numeral.",
        "section": "typography"
      },
      {
        "name": "The 16 Floor Rule",
        "body": "Texto de leitura e de campo nunca abaixo de 16 px.",
        "section": "typography"
      },
      {
        "name": "The Flat-By-Default Rule",
        "body": "Sem sombra em repouso nem em hover; hover é troca de tom.",
        "section": "elevation"
      }
    ],
    "dos": [
      "Do usar o vinho só para a ação principal, a seleção atual e o link.",
      "Do manter 4,5:1 em texto e 3:1 em contornos de controle.",
      "Do dar a todo alvo de toque 44 px no mínimo.",
      "Do acompanhar toda cor de estado de ícone e texto.",
      "Do terminar todo estado vazio com a próxima ação.",
      "Do mostrar esqueleto no formato do conteúdo enquanto carrega."
    ],
    "donts": [
      "Don't usar o dourado como segundo acento.",
      "Don't usar serifa em botão, campo ou rótulo.",
      "Don't pôr sombra, gradiente ou desfoque de fundo em superfícies.",
      "Don't aninhar cartões.",
      "Don't usar glifos de texto ou emoji como ícone.",
      "Don't reintroduzir o painel de números grandes.",
      "Don't usar animação de layout em listas na web: tira os itens do fluxo e quebra a rolagem."
    ]
  }
