# Copie para .env (local) e cadastre a mesma variável na Vercel (Settings > Environment Variables).
# URL da implantação "App da Web" do Apps Script. Termina em /exec (nunca use a /dev).
EXPO_PUBLIC_API_URL=https://script.google.com/macros/s/COLE_AQUI_O_ID_DA_IMPLANTACAO/exec

# Endereço do site da TeoCode (rodapé do app). Sem ele, o crédito aparece sem link.
EXPO_PUBLIC_TEOCODE_URL=https://teocode.com.br/
